# OpenAI-compatible chat API
# Use a unique password of at least 16 characters. Do not reuse a password shared in chat.
ADAM_OWNER_PASSWORD=replace-with-a-long-unique-password

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional local MCP server command. Only configure a command you trust.
MCP_SERVER_COMMAND=python mcp_server_example.py

# Optional A2A Agent Card URL and bearer token.
# Use only an HTTPS URL for an agent you trust.
A2A_AGENT_CARD_URL=
A2A_BEARER_TOKEN=
